# Normaliza fim de linha no repositorio (o dashboard e gerado em LF).
* text=auto eol=lf

# Binarios: sem conversao nem diff textual
*.png binary
*.jpg binary
*.jpeg binary
*.woff2 binary
*.ttf binary
*.bin binary
*.zip binary

# Artefatos gerados: nao poluir o diff
dashboard/index.html linguist-generated=true
data/canonical/*.json linguist-generated=true
data/interim/*.jsonl linguist-generated=true
